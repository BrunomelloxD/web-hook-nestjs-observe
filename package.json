{
  "name": "web-hook",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "preinstall": "npx --yes only-allow npm",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "turbo run generate",
    "test:storybook": "turbo run test:storybook",
    "build-storybook": "turbo run build-storybook",
    "storybook": "npm run storybook --workspace=apps/web",
    "check": "prettier --check . && turbo run lint typecheck test:cov build test:storybook build-storybook"
  },
  "devDependencies": {
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "turbo": "2.11.8"
  }
}
