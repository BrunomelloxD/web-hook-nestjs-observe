# Docker Compose only. App variables live in apps/<app>/.env.

# ---------- Postgres ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=<nome-do-projeto>
# Host port; change it if 5432 is taken.
POSTGRES_PORT=5432

# ---------- Host ports ----------
WEB_PORT=3000
API_PORT=3333
# Optional profiles (mock, docs)
MOCK_API_PORT=4010
STORYBOOK_PORT=6006
