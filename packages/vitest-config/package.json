{
  "name": "@repo/vitest-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Vitest settings (coverage rules) for apps and packages",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@repo/tsconfig": "*",
    "@vitest/coverage-v8": "4.1.12",
    "vitest": "4.1.12"
  }
}
