{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware src/ test/ e2e/ .storybook/ && node scripts/check-conventions.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "format": "prettier --write src test e2e .storybook scripts",
    "test:storybook": "vitest run --project storybook --project storybook-dark",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:conventions": "node scripts/check-conventions.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@repo/tsconfig": "*",
    "@repo/vitest-config": "*",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "playwright": "1.64.1",
    "shadcn": "4.21.5",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@repo/api-client": "*",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
