# Copy to apps/api/.env. Validated on startup (src/common/config/env.schema.ts).

# ---------- App ----------
APP_NAME="<nome-do-projeto>"
NODE_ENV=development
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated
CORS_ORIGIN=http://localhost:3000

# ---------- Rate limit ----------
# Window in ms and max requests per IP within it
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ---------- Prisma ----------
# Local runs (dev, tests, migrations). Must match the root .env credentials.
# Docker Compose overrides it with host "database".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/<nome-do-projeto>"

# ---------- Webhooks ----------
# Receiver of the chat events (the web). Docker Compose overrides the host.
WEBHOOK_TARGET_URL=http://localhost:3000/webhooks/chat
# whsec_ + base64 key (Standard Webhooks). Must match apps/web/.env.
WEBHOOK_SECRET=<webhook-secret>
